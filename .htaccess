# =========================================================
#  Shahriar LLC — Clean URLs (no .html) + permanent redirects
#  Apache / InfinityFree (mod_rewrite). Tested live.
# =========================================================
RewriteEngine On

# ---- 0) index -> root (avoid /index duplicate of "/") ---------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC,OR]
RewriteCond %{THE_REQUEST} \s/+index[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ---- 1) Permanent redirect: old "/foo.html" -> "/foo" ---------------
# Only for real .html requests (so assets are untouched). Query kept.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 2) Serve clean URL "/foo" from "/foo.html" (no redirect) -------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# ---- 3) Serve "/dir" from "/dir/index.html" -------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
